<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.1.0 -->
<interface>
  <!-- interface-name Cassava.ui -->
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <requires lib="libpanel" version="1.0"/>
  <template class="CassavaWindow" parent="AdwApplicationWindow">
    <child>
      <object class="PanelDock" id="dock">
        <property name="reveal-bottom">True</property>
        <child>
          <object class="PanelGrid" id="grid">
            <signal name="create-frame" handler="create_frame_cb"/>
          </object>
        </child>
        <child type="bottom">
          <object class="PanelPaned">
            <child>
              <object class="PanelFrame">
                <child>
                  <object class="PanelWidget">
                    <child>
                      <object class="GtkButton">
                        <property name="label">Test</property>
                        <signal name="clicked" handler="egg"/>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="PanelWidget">
                    <child>
                      <object class="GtkButton">
                        <property name="label">Test</property>
                        <signal name="clicked" handler="egg"/>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="PanelWidget">
                    <child>
                      <object class="GtkButton">
                        <property name="label">Test</property>
                        <signal name="clicked" handler="egg"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
